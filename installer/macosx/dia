#!/bin/sh
# Runtime paths are relative to the app, including when its name contains spaces.
set -eu
RESOURCES=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MACOS=$(CDPATH= cd -- "$RESOURCES/../MacOS" && pwd)
export DIA_BASE_PATH="$RESOURCES"
export DIA_LIB_PATH="$RESOURCES/lib/dia"
export DIA_SHEET_PATH="$RESOURCES/share/dia/sheets"
export DIA_SHAPE_PATH="$RESOURCES/share/dia/shapes"
export DIA_XSLT_PATH="$RESOURCES/share/dia/xslt"
export DIA_PYTHON_PATH="$RESOURCES/share/dia"
export DIA_LOCALE_PATH="$RESOURCES/share/locale"
export XDG_DATA_DIRS="$RESOURCES/share:/usr/share"
export GSETTINGS_SCHEMA_DIR="$RESOURCES/share/glib-2.0/schemas"
export GI_TYPELIB_PATH="$RESOURCES/lib/girepository-1.0"
export GIO_MODULE_DIR="$RESOURCES/lib/gio/modules"
export GTK_EXE_PREFIX="$RESOURCES"
export GTK_DATA_PREFIX="$RESOURCES"
export GTK_PATH="$RESOURCES/lib/gtk-3.0"
export PYTHONHOME="$RESOURCES/python"
PYTHON_VERSION=$(cat "$RESOURCES/python-version")
export PYTHONPATH="$PYTHONHOME/lib/python$PYTHON_VERSION/site-packages"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
if [ -d "$RESOURCES/etc/fonts" ]; then
    export FONTCONFIG_PATH="$RESOURCES/etc/fonts"
fi
# A per-launch cache avoids stale absolute paths after moving the app and races
# between simultaneous instances. Never write into the signed application.
CACHE=$(mktemp -d "${TMPDIR:-/tmp}/dia-loaders.XXXXXXXX")
trap 'rm -rf "$CACHE"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
export GDK_PIXBUF_MODULE_FILE="$CACHE/loaders.cache"
# Current GdkPixbuf keeps loaders under its own ABI version, not GTK's version.
find "$RESOURCES/lib/gdk-pixbuf-2.0" -type f \( -name '*.so' -o -name '*.dylib' \) -exec \
    "$RESOURCES/bin/gdk-pixbuf-query-loaders" '{}' + > "$GDK_PIXBUF_MODULE_FILE"
if [ -x "$RESOURCES/bin/gtk-query-immodules-3.0" ] && [ -d "$RESOURCES/lib/gtk-3.0" ]; then
    export GTK_IM_MODULE_FILE="$CACHE/immodules.cache"
    find "$RESOURCES/lib/gtk-3.0" -type f -path '*/immodules/*' \( -name '*.so' -o -name '*.dylib' \) -exec \
        "$RESOURCES/bin/gtk-query-immodules-3.0" '{}' + > "$GTK_IM_MODULE_FILE"
else
    unset GTK_IM_MODULE_FILE
fi
"$MACOS/dia-bin" "$@"
